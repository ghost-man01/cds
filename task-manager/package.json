{
  "name": "task-manager",
  "version": "1.0.0",
  "description": "CAP Task & Project Management API",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds deploy --to sqlite && cds watch"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "2"
  },
   "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "db": "task-manager.db"
      },
      "auth": {
        "kind": "dummy"
      }
    }
  }
}